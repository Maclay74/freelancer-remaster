execute_process(COMMAND "@Python3_EXECUTABLE@" "@PROJECT_SOURCE_DIR@/src/copy_dev_ini.py" "${CMAKE_INSTALL_PREFIX}/bin" COMMAND_ERROR_IS_FATAL ANY)
if(NOT "@FL_DATA_DIR@" STREQUAL "")
  if(NOT IS_DIRECTORY "@FL_DATA_DIR@")
    message(FATAL_ERROR "FL_DATA_DIR does not exist: @FL_DATA_DIR@")
  endif()
  set(data_link "${CMAKE_INSTALL_PREFIX}/DATA")
  if(EXISTS "${data_link}" OR IS_SYMLINK "${data_link}")
    execute_process(COMMAND "@Python3_EXECUTABLE@" -c
      "import os,sys; sys.exit(0 if os.path.samefile(sys.argv[1],sys.argv[2]) else 1)"
      "${data_link}" "@FL_DATA_DIR@" RESULT_VARIABLE same_data)
    if(NOT same_data EQUAL 0)
      message(FATAL_ERROR "Existing ${data_link} points elsewhere; remove the junction manually before changing FL_DATA_DIR.")
    endif()
  else()
    file(TO_NATIVE_PATH "${data_link}" native_link)
    file(TO_NATIVE_PATH "@FL_DATA_DIR@" native_data)
    execute_process(COMMAND cmd /c mklink /J "${native_link}" "${native_data}" COMMAND_ERROR_IS_FATAL ANY)
  endif()
endif()
